# Public Google Web OAuth client ID; never a password or client secret.
GOOGLE_CLIENT_ID=
# Turso/libSQL database for Vercel. Keep the token server-side.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Required only if enabling the existing administration API.
ADMIN_PASSWORD=
# Optional storefront shipping settings.
SHIP_FEE=250
FREE_SHIPPING_OVER=1999
