# Public Google Web OAuth client ID; never a password or client secret.
GOOGLE_CLIENT_ID=
# Turso/libSQL database for Vercel. Keep the token server-side.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Required only if enabling the existing administration API.
ADMIN_PASSWORD=
# Optional storefront shipping settings.
SHIP_FEE=250
FREE_SHIPPING_OVER=1999

# Server-side only: Google OAuth code flow (scope: openid email).
GOOGLE_CLIENT_SECRET=
# Random secret, at least 32 characters. Never use NEXT_PUBLIC_.
AUTH_SESSION_SECRET=
GOOGLE_REDIRECT_URI=https://ergong.vercel.app/api/auth/callback

# Server-side order email notification (fixed recipient: ergongbeef@gmail.com).
RESEND_API_KEY=
# Verified sender address, or Resend test sender for account-owner-only delivery.
ORDER_EMAIL_FROM=
